# ==========================================
# Verdant & Co AI Support - Configuration
# ==========================================

# Server port
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL: Neon, Supabase, Railway, or local Postgres)
PG_USER="postgres"
PG_PASSWORD="your_postgres_password"
PG_HOST="localhost"
PG_PORT="5432"
PG_DATABASE="verdant_support"
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/verdant_support?schema=public"

# Webhook Security
# Test secret specified in the Datastraw take-home assessment
WEBHOOK_SECRET="verdant-demo-secret-2026"

# Agent JWT Authentication Secret
JWT_SECRET="verdant-jwt-secret-dev-2026"

# LLM Providers (Multi-provider support: Groq, OpenAI, or Gemini)
# If no API key is provided, the system seamlessly uses the intelligent
# Verdant Knowledge Base Rule Engine fallback.

# Option 1: Groq (Recommended - Free Tier & Extremely Fast)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Option 2: OpenAI / OpenRouter / DeepInfra
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Option 3: Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
